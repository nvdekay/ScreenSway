{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenSway",
  "version": "0.1.0",
  "identifier": "app.screensway.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScreenSway",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Movies/ScreenSway/**"]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Beautiful screen recordings that follow the action.",
    "longDescription": "ScreenSway is a private, local-first screen recorder with automatic cursor-aware zooms and pans.",
    "macOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
