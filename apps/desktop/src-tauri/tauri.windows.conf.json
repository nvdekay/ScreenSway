{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "node ../../scripts/build-native.mjs && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ScreenSway",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#0b0b12"
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "externalBin": [
      "binaries/screensway-capture"
    ]
  }
}
