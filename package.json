{
  "name": "screensway",
  "version": "0.4.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @screensway/desktop dev",
    "dev:desktop": "pnpm --filter @screensway/desktop tauri dev",
    "dev:web": "pnpm --filter @screensway/web dev",
    "dev:studio-web": "pnpm --filter @screensway/studio-web dev",
    "dev:site": "pnpm --parallel --filter @screensway/web --filter @screensway/studio-web dev",
    "build": "pnpm -r build",
    "build:capture:macos": "node scripts/build-native.mjs",
    "test:capture:macos": "node scripts/build-native.mjs && node scripts/test-macos-capture.mjs",
    "build:desktop": "pnpm --filter @screensway/desktop tauri build",
    "build:capture:windows": "node scripts/build-native.mjs",
    "setup:windows-speech": "node scripts/setup-windows-speech.mjs",
    "test:capture:windows": "node scripts/build-native.mjs && node scripts/test-windows-capture.mjs",
    "test:export:windows": "node scripts/test-windows-export.mjs",
    "test:speech:windows": "node scripts/test-windows-transcribe.mjs",
    "build:windows": "pnpm --filter @screensway/desktop tauri build --bundles nsis",
    "build:macos": "pnpm --filter @screensway/desktop tauri build --target universal-apple-darwin --bundles app,dmg && node scripts/compress-dmg.mjs",
    "build:web": "pnpm --filter @screensway/web build",
    "build:studio-web": "pnpm --filter @screensway/studio-web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test"
  }
}

